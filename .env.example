# Anthropic — client-side (Vite exposes VITE_* vars to the browser)
VITE_ANTHROPIC_API_KEY=your_key_here

# Anthropic — server-side only (Vercel serverless functions in api/)
# Copy the same key here. This variable is never sent to the browser.
ANTHROPIC_API_KEY=your_key_here

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
