# Anthropic — client-side (Vite exposes VITE_* vars to the browser)
VITE_ANTHROPIC_API_KEY=your_key_here

# Anthropic — server-side only (Vercel serverless functions in api/)
# Copy the same key here. This variable is never sent to the browser.
ANTHROPIC_API_KEY=your_key_here

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ElevenLabs Conversational AI
VITE_ELEVENLABS_AGENT_ID=
# Server-side only — used by api/elevenlabs-signed-url.js to mint short-lived
# signed URLs so the agent can be set to "private" in the ElevenLabs dashboard.
# Restrict this key to Conversational AI access only (see ElevenLabs → API Keys).
ELEVENLABS_API_KEY=

# Google Maps Embed
VITE_GOOGLE_MAPS_KEY=
