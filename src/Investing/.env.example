# Twitter / X API v2 — get at developer.twitter.com
TWITTER_BEARER_TOKEN=your_bearer_token_here

# Alpaca — get at alpaca.markets (paper account is free)
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here

# Set to "1" for live trading, leave unset for paper
ALPACA_LIVE=

# Set to "0" to submit real orders, "1" to only log them
DRY_RUN=1
